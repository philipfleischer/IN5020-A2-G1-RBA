vetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="312" width="150" height="36" as="geometry"/></mxCell><mxCell id="p4-38" value="&amp;nbsp;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="905" y="392" width="30" height="36" as="geometry"/></mxCell><mxCell id="p4-39" value="&lt;b&gt;send på nytt&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1066" y="392" width="140" height="36" as="geometry"/></mxCell><mxCell id="p4-40" value="&lt;b&gt;FAIL, fjernet&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1390" y="392" width="140" height="36" as="geometry"/></mxCell><mxCell id="p4-41" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;sendt ved 0 s, ingen ACK&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="915" y="440" width="300" height="50" as="geometry"/></mxCell><mxCell id="p4-42" value="&lt;b&gt;Hvorfor vente på alle ACK før neste melding?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;Da kan ingen replika ligge mer enn én melding bak,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;og alle får meldingene i nøyaktig samme rekkefølge.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="620" width="750" height="105" as="geometry"/></mxCell><mxCell id="p4-43" value="&lt;b&gt;Hvorfor FAIL?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;En krasjet bank ville ellers blokkert hele gruppa for alltid.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;Oppgaven: tolerer at banker forsvinner, og fortsett.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="745" width="750" height="105" as="geometry"/></mxCell><mxCell id="p4-44" value="&lt;b&gt;Duplikater er ufarlige&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;En resend kan gi samme melding to ganger. Banken ser id-en&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;i executedIds, hopper over transaksjonen, men sender ACK likevel.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="870" width="750" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="6 Datastrukturer og tellere"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="880" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5-0" value="&lt;b&gt;Datastrukturene i en replika: hvor en transaksjon befinner seg&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1540" height="34" as="geometry"/></mxCell><mxCell id="p5-1" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;outstanding_collection → (ordnet) → executed_list, og to tellere som aldri nullstilles&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#444444;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1540" height="24" as="geometry"/></mxCell><mxCell id="p5-2" value="&lt;b&gt;Kommando&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;deposit NOK 100&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="125" width="190" height="90" as="geometry"/></mxCell><mxCell id="p5-3" value="&lt;b&gt;Utestående&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;i outstanding_collection&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;får id &quot;A 4&quot;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;outstanding_counter: 4 → 5&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="260" height="120" as="geometry"/></mxCell><mxCell id="p5-4" value="&lt;b&gt;Ordnet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;har fått plass i den&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;globale rekkefølgen&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="750" y="125" width="240" height="90" as="geometry"/></mxCell><mxCell id="p5-5" value="&lt;b&gt;Utført&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;saldo endret · order_counter++&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;lagt i executed_list og executedIds&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;fjernet fra outstanding_collection (hos A)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="470" height="140" as="geometry"/></mxCell><mxCell id="p5-6" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="220" y="170" as="sourcePoint"/><mxPoint x="270" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5-7" value="hvert 10. s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;(kan sendes flere ganger)&lt;/font&gt;" style="html=1;rounded=0;strokeColor=#2e7d32;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="530" y="170" as="sourcePoint"/><mxPoint x="750" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5-8" value="første gang" style="html=1;rounded=0;strokeColor=#1f5fa8;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="990" y="170" as="sourcePoint"/><mxPoint x="1100" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5-9" value="&lt;b&gt;Hoppes over&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;id-en finnes i executedIds&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;ACK sendes likevel&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="750" y="320" width="240" height="110" as="geometry"/></mxCell><mxCell id="p5-10" value="samme id igjen?" style="html=1;rounded=0;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="870" y="215" as="sourcePoint"/><mxPoint x="870" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5-11" value="&lt;b&gt;Ute av historikken&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;fjernet fra executed_list av cleanHistory&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;men fortsatt i executedIds → aldri utført på nytt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="1100" y="320" width="470" height="110" as="geometry"/></mxCell><mxCell id="p5-12" value="cleanHistory" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="1335" y="240" as="sourcePoint"/><mxPoint x="1335" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5-13" value="&lt;b&gt;Eksempel: getHistory&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;executed_list  = [deposit NOK 100, addInterest NOK 10]&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;outstanding    = [deposit NOK -50, addInterest NOK 5]&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;order_counter  = 5&lt;/font&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;Utskrift&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;executed_list&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;3. 2026-10-14 10:00:01.123 deposit NOK 100&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;4. 2026-10-14 10:00:11.456 addInterest NOK 10&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;outstanding_collection&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;deposit NOK -50&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;addInterest NOK 5&lt;/font&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;Utførte transaksjoner har nummer og tidspunkt for utførelse.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;Utestående har ingen nummer ennå: de får det først når de er ordnet.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="740" height="370" as="geometry"/></mxCell><mxCell id="p5-14" value="&lt;b&gt;Hvorfor starter nummereringen på 3?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;første nummer = order_counter − executed_list.size() = 5 − 2 = 3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;cleanHistory tømte lista etter transaksjon 0–2, men order_counter&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;nullstilles aldri. En transaksjon har samme nummer på alle replikaer.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="810" y="480" width="760" height="115" as="geometry"/></mxCell><mxCell id="p5-15" value="&lt;b&gt;checkTxStatus &amp;lt;id&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;EXECUTED: id-en finnes i executedIds&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;OUTSTANDING: ligger i outstanding_collection&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;UNKNOWN: ingen av delene   ·   «checkTxStatus 4» = «&amp;lt;denne banken&amp;gt; 4»&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="810" y="608" width="760" height="115" as="geometry"/></mxCell><mxCell id="p5-16" value="&lt;b&gt;To tellere som aldri nullstilles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;outstanding_counter: lager id-er, teller bare deposit og addInterest&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;order_counter: antall utførte transaksjoner (= neste ordrenummer)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;getSyncedBalance-markører får egne id-er: &quot;A sync-0&quot;, &quot;A sync-1&quot;, …&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="810" y="736" width="760" height="114" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="7 getSyncedBalance"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1040" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6-0" value="&lt;b&gt;getSyncedBalance: korrekt (markør i køen) mot naiv (vent på tom innkurv)&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRi