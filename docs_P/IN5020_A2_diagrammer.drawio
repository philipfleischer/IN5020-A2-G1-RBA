lle ser 3 medlemmer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="55" y="520" width="350" height="95" as="geometry"/></mxCell><mxCell id="p7-10" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="230" y="615" as="sourcePoint"/><mxPoint x="230" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-11" value="&lt;b&gt;Alle starter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;broadcast-tråd + kommandoer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="55" y="640" width="350" height="95" as="geometry"/></mxCell><mxCell id="p7-12" value="&lt;b&gt;Hvorfor vente?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;Ellers kan A sende en transaksjon&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;før C er med, og C mangler den&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;for alltid (C får ingen kopi).&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="55" y="900" width="350" height="130" as="geometry"/></mxCell><mxCell id="p7-13" value="&lt;b&gt;B  Ny replika (late join)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=top;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="400" height="950" as="geometry"/></mxCell><mxCell id="p7-14" value="&lt;b&gt;Bank D: join&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="475" y="160" width="350" height="95" as="geometry"/></mxCell><mxCell id="p7-15" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="650" y="255" as="sourcePoint"/><mxPoint x="650" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-16" value="&lt;b&gt;Vent til meldingen som pågår&lt;/b&gt;&lt;br&gt;&lt;b&gt;er ACK-et av alle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;ingen melding er halvveis levert&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="475" y="280" width="350" height="95" as="geometry"/></mxCell><mxCell id="p7-17" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="650" y="375" as="sourcePoint"/><mxPoint x="650" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-18" value="&lt;b&gt;Hent tilstanden fra en replika&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;BankState: saldoer, executed_list,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;order_counter, executedIds&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="475" y="400" width="350" height="95" as="geometry"/></mxCell><mxCell id="p7-19" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="650" y="495" as="sourcePoint"/><mxPoint x="650" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-20" value="&lt;b&gt;updateState(state) til D&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;D er nå lik de andre&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="475" y="520" width="350" height="95" as="geometry"/></mxCell><mxCell id="p7-21" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="650" y="615" as="sourcePoint"/><mxPoint x="650" y="640" as="targetPo