ly=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="871" height="40" as="geometry"/></mxCell><mxCell id="p9-27" value="&lt;b&gt;Terminal 5: ny replika (Rep2)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="510" height="70" as="geometry"/></mxCell><mxCell id="p9-28" value="&lt;b&gt;Rep2 · late join&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="612" y="465" width="787" height="40" as="geometry"/></mxCell><mxCell id="p9-29" value="&lt;b&gt;Terminal 6: ny replika (Rep3)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="535" width="510" height="70" as="geometry"/></mxCell><mxCell id="p9-30" value="&lt;b&gt;Rep3 · late join&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="717" y="550" width="745" height="40" as="geometry"/></mxCell><mxCell id="p9-31" value="&lt;b&gt;Kommandoen for en replika&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;java -jar jars/BankServer.jar localhost:1099 group01 3 input/final/TradingRate.txt input/final/Rep1.txt 2&amp;gt;&amp;amp;1 | tee output/final/rep1_a.txt&lt;/font&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;Naiv versjon: legg til -Dsync=naive før -jar.   Andre maskiner: legg til -Djava.rmi.server.hostname=&amp;lt;egen IP&amp;gt;.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;De tre første venter på hverandre (3/3). Replikaene som starter ved 5 s og 15 s ser allerede ≥ 3 medlemmer, får tilstanden og starter med en gang.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;Etterpå: alle replikaer som levde til slutten skal ha samme sluttsaldo, og samme transaksjon på hvert ordrenummer.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="1540" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>