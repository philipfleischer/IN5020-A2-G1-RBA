" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-17" value="neste melding" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=13;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="-0.64" relative="1" as="geometry"><mxPoint x="500" y="870" as="sourcePoint"/><mxPoint x="150" y="230" as="targetPoint"/><Array as="points"><mxPoint x="40" y="870"/><mxPoint x="40" y="230"/></Array></mxGeometry></mxCell><mxCell id="p4-18" value="&lt;b&gt;leave() (exit) fjerner banken fra pendingAcks med en gang&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;serveren venter aldri på en bank som har meldt seg ut&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="130" y="950" width="630" height="80" as="geometry"/></mxCell><mxCell id="p4-19" value="&lt;b&gt;Tidslinje for én melding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;A og B svarer, C har krasjet&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#000000;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=top;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="750" height="470" as="geometry"/></mxCell><mxCell id="p4-20" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="920" y="520" as="sourcePoint"/><mxPoint x="1500" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-2