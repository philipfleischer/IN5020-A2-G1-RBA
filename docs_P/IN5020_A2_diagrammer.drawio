<mxfile host="app.diagrams.net" type="device"><diagram id="p0" name="1 Hele systemet"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1220" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0-0" value="&lt;b&gt;Hele systemet: en replikert bankkonto over Java RMI&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1640" height="34" as="geometry"/></mxCell><mxCell id="p0-1" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Én Message Delivery server bestemmer rekkefølgen · hver bankserver er en full kopi (replika) av kontoen · alle replikaer utfører det samme i samme rekkefølge&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#444444;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1640" height="24" as="geometry"/></mxCell><mxCell id="p0-2" value="&lt;b&gt;Pilene er RMI-kall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;(begge sider er RMI-servere, Note 3)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;1  broadcastTransactions(liste)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;bank → server, hvert 10. sekund&lt;/font&gt;&lt;br&gt;&lt;b&gt;2  receiveTransaction(id, liste)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;server → alle banker, parallelt&lt;/font&gt;&lt;br&gt;&lt;b&gt;3  ack(navn, id)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;bank → server: «mottatt og utført»&lt;/font&gt;&lt;br&gt;&lt;b&gt;4  join · leave · membershipChanged&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;medlemskap begge veier&lt;/font&gt;&lt;br&gt;&lt;b&gt;5  updateState(BankState)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;server → ny bank (late join)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="360" height="335" as="geometry"/></mxCell><mxCell id="p0-3" value="&lt;b&gt;Message Delivery server  ·  MessageDeliveryServer.jar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#444444&quot;&gt;«Hovedkontoret»: bestemmer rekkefølgen, har ingen saldo selv&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=top;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="95" width="860" height="335" as="geometry"/></mxCell><mxCell id="p0-4" value="&lt;b&gt;RMI-register&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;port 1099&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;bankene finner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;serveren her&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="175" width="19