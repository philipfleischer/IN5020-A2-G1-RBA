K 100" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=13;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="150" y="190" as="sourcePoint"/><mxPoint x="450" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-13" value="&lt;b&gt;1  Lag en Transaction&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;command  = &quot;deposit NOK 100&quot;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;uniqueId = &quot;A 0&quot;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;legg i outstanding_collection&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;outstanding_counter: 0 → 1&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="470" y="215" width="330" height="115" as="geometry"/></mxCell><mxCell id="p3-14" value="getQuickBalance NOK" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=13;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="150" y="370" as="sourcePoint"/><mxPoint x="450" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-15" value="0.00  (ikke bokført ennå!)" style="html=1;rounded=0;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=13;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="450" y="405" as="sourcePoint"/><mxPoint x="150" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-16" value="&lt;b&gt;2  Venter på broadcast-tråden&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;opptil 10 sekunder&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="470" y="435" width="330" height="60" as="geometry"/></mxCell><mxCell id="p3-17" value="broadcastTransactions([deposit NOK 100 [A 0]])" style="html=1;rounded=0;strokeColor=#2e7d32;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="450" y="535" as="sourcePoint"/><mxPoint x="820" y="535" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-18" value="&lt;b&gt;3  Får meldings-id 7&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;legges bakerst i køen&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;sendes når melding 6 er ACK-et av alle&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="560" width="300" height="90" as="geometry"/></mxCell><mxCell id="p3-19" value="receiveTransaction(7, …)" style="html=1;rounded=0;strokeColor=#1f5fa8;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="820" y="680" as="sourcePoint"/><mxPoint x="450" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-20" value="receiveTransaction(7, …)" style="html=1;rounded=0;strokeColor=#1f5fa8;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="820" y="700" as="sourcePoint"/><mxPoint x="1160" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-21" value="receiveTransaction(7, …)  (parallelt)" style="html=1;rounded=0;strokeColor=#1f5fa8;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.24" relative="1" as="geometry"><mxPoint x="820" y="725" as="sourcePoint"/><mxPoint x="1450" y="725" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-22" value="&lt;b&gt;4  Utfør&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;saldo NOK += 100&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;order_counter++&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;legg i executed_list + executedIds&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;fjern [A 0] fra outstanding&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="310" y="760" width="280" height="125" as="geometry"/></mxCell><mxCell id="p3-23" value="&lt;b&gt;4  Utfør&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;saldo NOK += 100&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;order_counter++&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;legg i executed_list + executedIds&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;(ingenting å fjerne)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1020" y="760" width="280" height="125" as="geometry"/></mxCell><mxCell id="p3-24" value="&lt;b&gt;4  Utfør&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;saldo NOK += 100&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;order_counter++&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;legg i executed_list + executedIds&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;(ingenting å fjerne)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1310" y="760" width="280" height="125" as="geometry"/></mxCell><mxCell id="p3-25" value="ack(A, 7)" style="html=1;rounded=0;strokeColor=#2e7d32;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="450" y="925" as="sourcePoint"/><mxPoint x="820" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-26" value="ack(B, 7)" style="html=1;rounded=0;strokeColor=#2e7d32;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="1160" y="945" as="sourcePoint"/><mxPoint x="820" y="945" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-27" value="ack(C, 7)" style="html=1;rounded=0;strokeColor=#2e7d32;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;" edge="1" parent="1"><mxGeometry x="-0.24" relative="1" as="geometry"><mxPoint x="1450" y="970" as="sourcePoint"/><mxPoint x="820" y="970" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-28" value="&lt;b&gt;5  Alle 3 ACK er kommet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;→ melding 8 kan sendes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;mangler én: resend etter 2 s,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;FAIL etter 5 s&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="1000" width="300" height="95" as="geometry"/></mxCell><mxCell id="p3-29" value="&lt;b&gt;Resultat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Alle tre replikaene har utført «A 0» som samme ordrenummer, og saldoen er lik overalt.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Mellom 1 og 4 viser getQuickBalance den gamle saldoen. Det er derfor getSyncedBalance finnes.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;A ser sin egen transaksjon komme tilbake på samme måte som de andre, og bokfører den først da.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="1140" width="1540" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5 ACK, resend og FAIL"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4-0" value="&lt;b&gt;Message Delivery serveren: én melding om gangen, ACK, resend og FAIL&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1540" height="34" as="geometry"/></mxCell><mxCell id="p4-1" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Løkka i processMessages(), og hva som skjer når en bank ikke svarer&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#444444;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1540" height="24" as="geometry"/></mxCell><mxCell id="p4-2" value="&lt;b&gt;Ta neste melding fra køen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;messageQueue.take(), venter hvis tom&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="150" y="180" width="300" height="70" as="geometry"/></mxCell><mxCell id="p4-3" value="&lt;b&gt;Øyeblikksbilde av medlemslista&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;pendingAcks = alle medlemmer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="150" y="290" width="300" height="70" as="geometry"/></mxCell><mxCell id="p4-4" value="&lt;b&gt;Send til alle samtidig&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;receiveTransaction(id, liste)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="150" y="400" width="300" height="70" as="geometry"/></mxCell><mxCell id="p4-5" value="&lt;b&gt;Alle ACK&lt;/b&gt;&lt;br&gt;&lt;b&gt;innen 2 s?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="180" y="510" width="240" height="120" as="geometry"/></mxCell><mxCell id="p4-6" value="&lt;b&gt;Send på nytt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;til de som mangler (samme id)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="500" y="535" width="260" height="70" as="geometry"/></mxCell><mxCell id="p4-7" value="&lt;b&gt;Alle ACK&lt;/b&gt;&lt;br&gt;&lt;b&gt;innen 5 s?&lt;/b&gt;" style="rhombus