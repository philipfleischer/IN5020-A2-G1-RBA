olor=&quot;#444444&quot;&gt;Uten lås kan receiveTransaction fjerne en transaksjon fra innkurven&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;mens broadcast-tråden kopierer den: feil resultat eller&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;ConcurrentModificationException.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="750" height="120" as="geometry"/></mxCell><mxCell id="p8-15" value="&lt;b&gt;Hvorfor vente uten lås?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;getSyncedBalance venter på svaret uten å holde låsen.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;Ellers kunne receiveTransaction aldri levert svaret: vranglås.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="810" y="860" width="750" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="10 Kjøring og testscenario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p9-0" value="&lt;b&gt;Slik kjøres testscenariet: seks terminaler&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1540" height="34" as="geometry"/></mxCell><mxCell id="p9-1" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Eksempel: 3 replikaer fra start, én ny etter 5 s og én ny etter 15 s (sjekk mot årets README.txt)&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#444444;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1540" height="24" as="geometry"/></mxCell><mxCell id="p9-2" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="560" y="640" as="sourcePoint"/><mxPoint x="1557" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9-3" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=none;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="560" y="632" as="sourcePoint"/><mxPoint x="560" y="648" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9-4" value="&lt;b&gt;0 s&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="530" y="652" width="60" height="24" as="geometry"/></mxCell><mxCell id="p9-5" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=none;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1