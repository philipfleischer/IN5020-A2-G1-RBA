raphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8-0" value="&lt;b&gt;Trådene i en bankserver, og hvorfor de må låse&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1540" height="34" as="geometry"/></mxCell><mxCell id="p8-1" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Fire–fem tråder bruker den samme tilstanden samtidig&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#444444;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1540" height="24" as="geometry"/></mxCell><mxCell id="p8-2" value="&lt;b&gt;Delt tilstand i BankServer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#444444&quot;&gt;beskyttet av synchronized (låsen på objektet)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=top;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="480" height="330" as="geometry"/></mxCell><mxCell id="p8-3" value="&lt;font face=&quot;Courier New&quot;&gt;balances&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;outstandingCollection&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;executedList&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;executedIds&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;orderCounter, outstandingCounter&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pendingSyncResults&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontColor=#000000;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="590" y="390" width="420" height="215" as="geometry"/></mxCell><mxCell id="p8-4" value="&lt;b&gt;Kommandotråd (main)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;leser terminalen eller fila (0,5–1,5 s mellom linjene)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;deposit, addInterest: legger i outstanding&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;getHistory, checkTxStatus: leser&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="450" height="150" as="geometry"/></mxCell><mxCell id="p8-5" value="&lt;b&gt;Broadcast-tråd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;hvert 10. s: kopi av outstanding_collection&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;→ broadcastTransactions()&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="450" height="130" as="geometry"/></mxCell><mxCell id="p8-6" value="&lt;b&gt;RMI-tråd: receiveTransaction()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;kalt av serveren for hver melding&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;utfører, svarer egne markører, sender ACK&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="140" width="450" height="150" as="geometry"/></mxCell><mxCell id="p8-7" value="&lt;b&gt;RMI-tråder: membershipChanged(),&lt;/b&gt;&lt;br&gt;&lt;b&gt;updateState()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;membershipChanged bruker en egen lås&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;(membershipLock) og vekker oppstarten&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="500" width="450" height="150" as="geometry"/></mxCell><mxCell id="p8-8" value="&lt;b&gt;Naiv getSyncedBalance-tråd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;bare med -Dsync=naive&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;sjekker hvert 200 ms om innkurven er tom&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="720" width="480" height="100" as="geometry"/></mxCell><mxCell id="p8-9" valu