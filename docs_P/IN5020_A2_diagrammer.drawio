rgetPoint"/></mxGeometry></mxCell><mxCell id="p2-27" value="&lt;b&gt;220 USD&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1260" y="530" width="200" height="50" as="geometry"/></mxCell><mxCell id="p2-28" value="" style="html=1;rounded=0;strokeColor=#1f5fa8;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="1100" y="270" as="sourcePoint"/><mxPoint x="1000" y="330" as="targetPoint"/><Array as="points"><mxPoint x="1100" y="300"/><mxPoint x="1000" y="300"/></Array></mxGeometry></mxCell><mxCell id="p2-29" value="" style="html=1;rounded=0;strokeColor=#1f5fa8;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="1290" y="270" as="sourcePoint"/><mxPoint x="1360" y="330" as="targetPoint"/><Array as="points"><mxPoint x="1290" y="300"/><mxPoint x="1360" y="300"/></Array></mxGeometry></mxCell><mxCell id="p2-30" value="&lt;b&gt;220 = 220: alle replikaer er like&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#444444&quot;&gt;samme start + samme operasjoner i samme rekkefølge = samme slutt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="860" y="620" width="670" height="90" as="geometry"/></mxCell><mxCell id="p2-31" value="&lt;b&gt;Dette er en replikert tilstandsmaskin.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Kontoen er en tilstandsmaskin: tilstanden er saldoene, og hver transaksjon er en overgang.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Starter alle replikaer i samme tilstand (0.0) og utfører de samme overgangene i samme rekkefølge, ender de i samme tilstand.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Den totale rekkefølgen er alt Message Delivery serveren trenger å garantere.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="1540" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4 En transaksjons livsløp"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1330" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3-0" value="&lt;b&gt;En transaksjons livsløp: «deposit NOK 100» på bank A&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1540" height="34" as="geometry"/></mxCell><mxCell id="p3-1" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Fra kommandoen skrives til alle tre replikaene har utført den&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#444444;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;"