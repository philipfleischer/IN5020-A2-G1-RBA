p6-10" value="&lt;b&gt;getSyncedBalance USD&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;A sync-0   (markør)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="280" width="290" height="55" as="geometry"/></mxCell><mxCell id="p6-11" value="&lt;b&gt;deposit NOK 100&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;A 1&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="280" width="250" height="55" as="geometry"/></mxCell><mxCell id="p6-12" value="samme rekkefølge på alle replikaer" style="html=1;rounded=0;strokeColor=#1f5fa8;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="465" y="335" as="sourcePoint"/><mxPoint x="465" y="385" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p6-13" value="&lt;b&gt;utfør&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;saldo: 100 USD&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="385" width="250" height="70" as="geometry"/></mxCell><mxCell id="p6-14" value="&lt;b&gt;markør: bare A svarer&lt;/b&gt;&lt;br&gt;&lt;b&gt;Synced balance: 100.00&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=3;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="385" width="290" height="70" as="geometry"/></mxCell><mxCell id="p6-15" value="&lt;b&gt;utfør&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;saldo: 110 USD totalt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="385" width="250" height="70" as="geometry"/></mxCell><mxCell id="p6-16" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="310" y="420" as="sourcePoint"/><mxPoint x="320" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p6-17" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="610" y="420" as="sourcePoint"/><mxPoint x="620" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p6-18" value="&lt;b&gt;Svaret er tilstanden akkurat der forespørselen står&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;alt som er ordnet før markøren er med, ingenting etter&lt;/font&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;Alltid ferdig etter én broadcast-runde&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;≤ 10 s + levering, uansett hvor mye trafikk det er&lt;/font&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;Andre replikaer ignorerer markøren&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;den fjernes fra outstanding_collection, men legges&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;ikke i executed_list og teller ikke i order_counter&lt;/font&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;Blokkerer ikke kommandoene&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;svaret skrives ut når markøren kommer tilbake&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="920" y="175" width="620" height="305" as="geometry"/></mxCell><mxCell id="p6-19" value="&lt;b&gt;Naiv  (-Dsync=naive)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#444444&quot;&gt;svar først når outstanding_collection er tom&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=top;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="525" width="1540" height="380" as="geometry"/></mxCell><mxCell id="p6-20" value="&lt;b&gt;1  deposit USD 100&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="230" height="50" as="geometry"/></mxCell><mxCell id="p6-21" value="&lt;b&gt;2  getSyncedBalance USD&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="270" height="50" as="geometry"/></mxCell><mxCell id="p6-22" value="&lt;b&gt;3  deposit NOK 100&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="600" width="230" height="50" as="geometry"/></mxCell><mxCell id="p6-23" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="290" y="625" as="sourcePoint"/><mxPoint x="330" y="625" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p6-24" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometry"><mxPoint x="600" y="625" as="sourcePoint"/><mxPoint x="640" y="625" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p6-25" value="&lt;b&gt;outstanding_collection ved neste broadcast:&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="668" width="600" height="26" as="geometry"/></mxCell><mxCell id="p6-26" value="&lt;b&gt;deposit USD 100&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;A 0&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="698" width="250" height="55" as="geometry"/></mxCell><mxCell id="p6-27" value="&lt;b&gt;deposit NOK 100&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;A 1&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="698" width="250" height="55" as="geometry"/></mxCell><mxCell id="p6-28" value="&lt;b&gt;egen tråd sjekker hvert 200 ms:&lt;/b&gt;&lt;br&gt;&lt;b&gt;«er innkurven tom?»&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="580" y="698" width="290" height="55" as="geometry"/></mxCell><mxCell id="p6-29" value="&lt;b&gt;Innkurven er tom først når begge er utført&lt;/b&gt;&lt;br&gt;&lt;b&gt;Synced balance: 110.00&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;tar med deposit NOK 100, som ble gitt ETTER forespørselen&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=3;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="785" width="810" height="90" as="geometry"/></mxCell><mxCell id="p6-30" value="&lt;b&gt;Venter på et øyeblikk med tom innkurv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;svaret tar med transaksjoner som kom etter forespørselen&lt;/font&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;Kan vente for alltid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;kommer det stadig nye transaksjoner, blir innkurven&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;aldri tom (starvation, «deadlock» i oppgaveteksten)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;Observert med eksempelfila&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;2. kall: 100.00 (korrekt) mot 110.00 (naiv)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;4. kall: 120.00 (korrekt) mot 306.00 (naiv)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="920" y="600" width="620" height="275" as="geometry"/></mxCell><mxCell id="p6-31" value="&lt;b&gt;Begge versjonene blokkerer ikke kommandoløkka.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;Bare slik kan nye transaksjoner komme inn mens forespørselen venter, og forskjellen blir synlig.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="930" width="1540" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="8 Medlemskap"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7-0" value="&lt;b&gt;Medlemskap: oppstart, ny replika, utmelding og krasj&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1640" height="34" as="geometry"/></mxCell><mxCell id="p7-1" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#444444&quot;&gt;Serveren eier medlemslista. Alle endringer sendes til alle med membershipChanged()&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#444444;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1640" height="24" as="geometry"/></mxCell><mxCell id="p7-2" value="&lt;b&gt;A  Oppstart&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=top;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="400" height="950" as="geometry"/></mxCell><mxCell id="p7-3" value="&lt;b&gt;Bank A: join&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#444444&quot;&gt;medlemmer 1/3 → venter&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="55" y="160" width="350" height="95" as="geometry"/></mxCell><mxCell id="p7-4" value="" style="html=1;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1"><mxGeometry x="0.00" relative="1" as="geometr